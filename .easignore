# Exclude unrelated monorepo sources, reports and local control directories.
/.git
/.github/
/.agents/
/.codex/
/.aws/
/server/
/web/
/cloudflare/
/output/
/docs/
/tmp/
/.tmp/
/temp/
/scratch/
/deliverables/
/node_modules/

# Sensitive/generated exclusions apply throughout the mobile source tree.
**/node_modules/
**/.expo/
**/.expo-verification-output/
**/.tmp-expo-*/
**/dist/
**/web-build/
**/.env
**/.env.*
**/.dev.vars*
**/*serviceAccount*.json
**/credentials.json
**/*.jks
**/*.p8
**/*.p12
**/*.key
**/*.pem
**/*.keystore
**/*.mobileprovision
**/*.log
**/*.apk
**/*.aab
**/*.msi
**/*.tsbuildinfo
/mobile/android/
/mobile/ios/
