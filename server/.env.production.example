NODE_ENV=production
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=https://app.your-hugpong-domain.example

SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SMS_PROVIDER=iprog
IPROG_SMS_API_TOKEN=replace-with-the-server-only-iprog-api-token

# Optional Semaphore rollback configuration. Leave unset when IPROG is active.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SEMAPHORE

# Prefer workload identity. Use this only when the hosting provider requires a credential file.
FIREBASE_PROJECT_ID=replace-with-production-project-id
GOOGLE_APPLICATION_CREDENTIALS=/provider-managed-secrets/hugpong-service-account.json

# One-time initial Super Admin bootstrap. Keep these unset during normal
# runtime. Set them only for the explicit command, then remove them immediately.
# HUGPONG_ALLOW_PRODUCTION_BOOTSTRAP=true
# HUGPONG_PRODUCTION_BOOTSTRAP_CONFIRM=CREATE_INITIAL_HUGPONG_SUPER_ADMIN
# HUGPONG_PRODUCTION_BOOTSTRAP_PROJECT_ID=replace-with-production-project-id
# HUGPONG_BOOTSTRAP_FIRST_NAME=replace-with-first-name
# HUGPONG_BOOTSTRAP_MIDDLE_NAME=
# HUGPONG_BOOTSTRAP_LAST_NAME=replace-with-last-name
# HUGPONG_BOOTSTRAP_SUFFIX=
# HUGPONG_BOOTSTRAP_PHONE=09XXXXXXXXX
# HUGPONG_BOOTSTRAP_TEMPORARY_PASSWORD=replace-with-a-unique-temporary-password
