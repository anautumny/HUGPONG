{
  "name": "hugpong-server",
  "version": "1.0.0",
  "description": "HUGPONG Backend & Security Gateway Server",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "audit:deployment-config": "node scripts/auditDeploymentConfig.js",
    "audit:secrets": "node scripts/auditSecretExposure.js",
    "audit:runtime-authority": "node scripts/auditRuntimeAuthority.js",
    "verify:release": "node scripts/verifyRelease.js",
    "measure:hosting": "node scripts/measureHostingCapacity.js",
    "measure:application": "node scripts/measureApplicationCapacity.js",
    "audit:crop-years": "node scripts/auditCropYearIntegrity.js",
    "reset:crop-year": "node scripts/resetActiveCropYear.js",
    "audit:legacy-data": "node scripts/migrateLegacyData.js",
    "migrate:legacy-data": "node scripts/migrateLegacyData.js --execute",
    "cleanup:deleted-user": "node scripts/cleanupDeletedUser.js",
    "bootstrap:production-super-admin": "node scripts/bootstrapProductionSuperAdmin.js",
    "bootstrap:dev-test-accounts": "node scripts/bootstrapDevelopmentTestAccounts.js",
    "reset:dev-firestore:plan": "node scripts/resetDevelopmentFirestore.js",
    "reset:dev-firestore": "node scripts/resetDevelopmentFirestore.js --execute"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "express-session": "^1.18.2",
    "firebase-admin": "^14.5.0"
  },
  "private": true
}
