# Generate a unique value with at least 32 random characters. Never commit the real value.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Rotate the previously exposed Semaphore key in the provider dashboard, then set the new value here.
SEMAPHORE_API_KEY=replace-with-the-rotated-semaphore-api-key
SEMAPHORE_SENDER_NAME=SEMAPHORE

# Comma-separated browser origins allowed to send credentialed API requests.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required only when running the administrative bootstrap script.
HUGPONG_BOOTSTRAP_PASSWORD=replace-with-a-unique-bootstrap-password
HUGPONG_SEED_PASSWORD=replace-with-a-unique-non-production-seed-password

# Firebase Admin must have credentials capable of signing custom tokens.
# Prefer workload identity/application default credentials in deployed environments.
GOOGLE_APPLICATION_CREDENTIALS=C:\\secure-path\\hugpong-service-account.json

PORT=3000

# Destructive development reset gates. Set these only for the one command that
# intentionally clears the expected Firestore project, then remove/disable them.
ALLOW_DEVELOPMENT_DATABASE_RESET=false
DEVELOPMENT_DATABASE_RESET_CONFIRM=RESET_HUGPONG_DEVELOPMENT_DATA
HUGPONG_EXPECTED_FIREBASE_PROJECT_ID=hugpong-ff
