# Generate a unique value with at least 32 random characters. Never commit the real value.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Development may use console delivery. To test IPROG, set SMS_PROVIDER=iprog
# and keep the token only in this ignored server environment file.
SMS_PROVIDER=console
IPROG_SMS_API_TOKEN=

# Optional rollback provider. Never reuse a previously exposed Semaphore key.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SEMAPHORE

# Comma-separated browser origins allowed to send credentialed API requests.
# Production must replace this with its exact HTTPS Web origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The production Super Admin bootstrap variables are documented in
# .env.production.example. Never leave its allow flag or temporary password in
# the normal runtime environment.

# Firebase Admin must have credentials capable of signing custom tokens.
# Prefer workload identity/application default credentials in deployed environments.
FIREBASE_PROJECT_ID=replace-with-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:\\secure-path\\hugpong-service-account.json

# Cloud platforms commonly inject PORT. The server always binds externally.
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# Destructive development reset gates. Set these only for the one command that
# intentionally clears the expected Firestore project, then remove/disable them.
ALLOW_DEVELOPMENT_DATABASE_RESET=false
DEVELOPMENT_DATABASE_RESET_CONFIRM=RESET_HUGPONG_DEVELOPMENT_DATA
HUGPONG_EXPECTED_FIREBASE_PROJECT_ID=replace-with-development-project-id

# One-time legacy-data migration gates. Leave disabled during normal runtime.
# Execution also requires the migrate:legacy-data script's --execute flag.
HUGPONG_ALLOW_LEGACY_MIGRATION=false
HUGPONG_MIGRATION_PROJECT_ID=replace-with-exact-active-project-id
