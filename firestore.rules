rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // HUGPONG clients authenticate with Firebase, but application data is
    // authorized and accessed only through the Express API. Firebase Admin on
    // the server bypasses these rules. No Web or Mobile client may read or
    // mutate a database document directly.
    match /users/{documentId} {
      allow read, write: if false;
    }

    match /user_credentials/{documentId} {
      allow read, write: if false;
    }

    match /account_identifiers/{documentId} {
      allow read, write: if false;
    }

    match /block_farms/{documentId} {
      allow read, write: if false;
    }

    match /fields/{documentId} {
      allow read, write: if false;
    }

    match /crop_cycles/{documentId} {
      allow read, write: if false;
    }

    match /operation_logs/{documentId} {
      allow read, write: if false;
    }

    match /audit_reports/{documentId} {
      allow read, write: if false;
    }

    match /audit_logs/{documentId} {
      allow read, write: if false;
    }

    match /sra_prices/{documentId} {
      allow read, write: if false;
    }

    match /support_tickets/{documentId} {
      allow read, write: if false;
    }

    match /terminal_diagnostics/{documentId} {
      allow read, write: if false;
    }

    // Sanitized technical failures are server-written and available only
    // through the Super Admin diagnostics API.
    match /diagnostic_events/{documentId} {
      allow read, write: if false;
    }

    // Backup archives never live in Firestore. This collection stores only
    // server-created operation metadata for Super Admin status reporting.
    match /backup_operations/{documentId} {
      allow read, write: if false;
    }

    match /server_sessions/{documentId} {
      allow read, write: if false;
    }

    match /security_rate_limits/{documentId} {
      allow read, write: if false;
    }

    match /password_recovery_challenges/{documentId} {
      allow read, write: if false;
    }

    // One-time server bootstrap markers and other infrastructure state are
    // never client-readable or client-writable.
    match /system_metadata/{documentId} {
      allow read, write: if false;
    }

    // New collections are private by default until a server/API policy is
    // intentionally implemented. This rule must remain last and deny-all.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
