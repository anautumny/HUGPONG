{
  "cli": {
    "version": ">= 24.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.22.1",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "node": "24.22.1",
      "autoIncrement": true,
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_API_BASE_URL": "https://hugpong-beta.onrender.com" },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "24.22.1",
      "autoIncrement": true,
      "environment": "production",
      "env": { "EXPO_PUBLIC_API_BASE_URL": "https://hugpong-beta.onrender.com" }
    }
  },
  "submit": {
    "production": {}
  }
}
