# Required non-secret API origin. Production builds must use public HTTPS.
# This public origin is also configured in the preview/production EAS profiles.
EXPO_PUBLIC_API_BASE_URL=https://hugpong.org

# Firebase Mobile client configuration. Set the matching values in the Expo/EAS
# build environment; never copy development configuration into production.
EXPO_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-mobile-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace-with-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=replace-with-mobile-app-id
