# Set this value in the Expo/EAS production environment before creating the installed build.
EXPO_PUBLIC_API_BASE_URL=https://api.your-hugpong-domain.example
EXPO_PUBLIC_FIREBASE_API_KEY=replace-with-production-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-production-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace-with-production-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-production-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-production-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=replace-with-production-mobile-app-id
