{
  "expo": {
    "name": "HUGPONG",
    "slug": "hugpong",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/HUGPONG LOGO.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/HUGPONG LOGO.png",
        "backgroundColor": "#F7F9F4"
      },
      "package": "com.anonymous.hugpong",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "HUGPONG needs camera access to scan and verify SRA compliance QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HUGPONG needs photo access only when you choose an image containing an SRA audit QR code."
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/HUGPONG LOGO.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F9F4"
        }
      ],
      "expo-sharing"
    ],
    "web": {
      "favicon": "./assets/HUGPONG LOGO.png"
    }
  }
}
