{
  "expo": {
    "name": "HUGPONG",
    "slug": "hugpong",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/HUGPONG LOGO.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/HUGPONG LOGO.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F9F4"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "HUGPONG needs camera access to scan and verify SRA compliance QR codes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/HUGPONG LOGO.png",
        "backgroundColor": "#F7F9F4"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.hugpong",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "HUGPONG needs camera access to scan and verify SRA compliance QR codes."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/HUGPONG LOGO.png"
    }
  }
}
